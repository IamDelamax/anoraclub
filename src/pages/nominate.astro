---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Nominate a Friend — Anora Club"
  description="Know someone who'd be a great fit for Anora Club? Nominate them for membership."
  canonicalPath="/nominate"
>
  <Nav />

  <section class="flex min-h-screen items-center justify-center bg-warm-white px-6 pt-24 pb-20">
    <div class="mx-auto w-full max-w-[700px]">
      <!-- Header -->
      <div id="nominate-header" class="mb-10 text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
          Nominate a Friend
        </p>
        <h1
          class="font-serif font-normal leading-tight"
          style="font-size: clamp(2.2rem, 4vw, 3.2rem); letter-spacing: -0.02em;"
        >
          Know someone great?
        </h1>
        <p class="mx-auto mt-4 max-w-md text-base font-light text-muted" style="line-height: 1.75;">
          The best members come through referrals. Tell us who you have in mind.
        </p>
      </div>

      <!-- Nomination form -->
      <form id="nominate-form" class="space-y-6">
        <div>
          <label for="your_name" class="mb-1.5 block text-xs font-medium uppercase tracking-[0.12em] text-muted">Your Name</label>
          <input type="text" id="your_name" name="your_name" required
            class="w-full rounded-xl border border-divider bg-cream px-4 py-3 text-sm text-charcoal outline-none transition-colors focus:border-gold" />
        </div>

        <div>
          <label for="your_email" class="mb-1.5 block text-xs font-medium uppercase tracking-[0.12em] text-muted">Your Email</label>
          <input type="email" id="your_email" name="your_email" required
            class="w-full rounded-xl border border-divider bg-cream px-4 py-3 text-sm text-charcoal outline-none transition-colors focus:border-gold" />
        </div>

        <div>
          <label for="friend_name" class="mb-1.5 block text-xs font-medium uppercase tracking-[0.12em] text-muted">Friend's Name</label>
          <input type="text" id="friend_name" name="friend_name" required
            class="w-full rounded-xl border border-divider bg-cream px-4 py-3 text-sm text-charcoal outline-none transition-colors focus:border-gold" />
        </div>

        <div>
          <label for="friend_contact" class="mb-1.5 block text-xs font-medium uppercase tracking-[0.12em] text-muted">Friend's Email or Instagram</label>
          <input type="text" id="friend_contact" name="friend_contact" required placeholder="email@example.com or @instagram"
            class="w-full rounded-xl border border-divider bg-cream px-4 py-3 text-sm text-charcoal outline-none transition-colors focus:border-gold placeholder:text-muted/40" />
        </div>

        <div>
          <label for="why" class="mb-1.5 block text-xs font-medium uppercase tracking-[0.12em] text-muted">Why would they be a great member?</label>
          <textarea id="why" name="why" rows="4" required
            class="w-full resize-none rounded-xl border border-divider bg-cream px-4 py-3 text-sm text-charcoal outline-none transition-colors focus:border-gold"></textarea>
        </div>

        <!-- Error message -->
        <div id="nominate-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-4 text-center text-sm text-red-600"></div>

        <div class="pt-4 text-center">
          <button
            type="submit"
            id="nominate-submit"
            class="rounded-full bg-charcoal px-10 py-3.5 text-sm font-medium text-cream transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
          >
            Submit Nomination
          </button>
          <p class="mt-4 text-xs font-light text-muted">
            We appreciate your referral. We'll reach out to your friend directly.
          </p>
        </div>
      </form>

      <!-- Success message (hidden by default) -->
      <div id="nominate-success" class="hidden py-20 text-center">
        <h2 class="font-serif text-3xl text-charcoal" style="letter-spacing: -0.02em;">Thank you.</h2>
        <p class="mt-4 text-base font-light text-muted" style="line-height: 1.75;">
          We've received your nomination and will reach out to your friend.
        </p>
        <a href="/" class="mt-8 inline-block text-sm font-medium text-gold transition-colors hover:text-charcoal">
          &larr; Back to home
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { db } from '../lib/firebase';
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';

  const form = document.getElementById('nominate-form') as HTMLFormElement;
  const submitBtn = document.getElementById('nominate-submit') as HTMLButtonElement;
  const errorDiv = document.getElementById('nominate-error') as HTMLDivElement;
  const successDiv = document.getElementById('nominate-success') as HTMLDivElement;
  const headerDiv = document.getElementById('nominate-header') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    const formData = new FormData(form);

    try {
      await addDoc(collection(db, 'nominations'), {
        nominatorName: formData.get('your_name'),
        nominatorEmail: formData.get('your_email'),
        friendName: formData.get('friend_name'),
        friendContact: formData.get('friend_contact'),
        reason: formData.get('why'),
        createdAt: serverTimestamp(),
        status: 'pending',
      });

      form.style.display = 'none';
      headerDiv.style.display = 'none';
      successDiv.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      console.error('Error submitting nomination:', err);
      errorDiv.textContent = 'Something went wrong. Please try again.';
      errorDiv.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Nomination';
    }
  });
</script>
