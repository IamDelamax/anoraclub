---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Vote on Our New Name — Anora Club"
  description="Help us choose the perfect name for our private social club."
  canonicalPath="/vote"
>
  <Nav />

  <section class="min-h-screen bg-warm-white px-6 pt-32 pb-20">
    <div class="mx-auto max-w-[640px]">
      <!-- Header -->
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
        Help Us Decide
      </p>
      <h1 class="font-serif font-normal leading-[1.1]" style="font-size: clamp(2.2rem, 5vw, 3.5rem); letter-spacing: -0.03em;">
        What should we <span class="italic text-gold">be called?</span>
      </h1>
      <p class="mt-4 max-w-lg text-base font-light leading-relaxed text-muted" style="line-height: 1.75;">
        We're evolving, and the name should reflect who we are. Vote for your favorite, or suggest something new. Individual ballots stay private.
      </p>

      <!-- Voting Form -->
      <div id="vote-form" class="mt-12">
        <!-- Name Options -->
        <div class="space-y-3" id="options-list">
          <label class="vote-option group flex cursor-pointer items-center gap-4 rounded-xl border border-divider bg-white/60 px-5 py-4 transition-all hover:border-gold/40 hover:bg-white">
            <input type="radio" name="clubName" value="Power Couple Club" class="h-4 w-4 accent-gold" />
            <div>
              <span class="text-base font-medium text-charcoal">Power Couple Club</span>
              <p class="mt-0.5 text-xs font-light text-muted">Bold. Direct. Says exactly what it is.</p>
            </div>
          </label>

          <label class="vote-option group flex cursor-pointer items-center gap-4 rounded-xl border border-divider bg-white/60 px-5 py-4 transition-all hover:border-gold/40 hover:bg-white">
            <input type="radio" name="clubName" value="Kindred Club" class="h-4 w-4 accent-gold" />
            <div>
              <span class="text-base font-medium text-charcoal">Kindred Club</span>
              <p class="mt-0.5 text-xs font-light text-muted">Finding your people. Warm, inviting, timeless.</p>
            </div>
          </label>

          <label class="vote-option group flex cursor-pointer items-center gap-4 rounded-xl border border-divider bg-white/60 px-5 py-4 transition-all hover:border-gold/40 hover:bg-white">
            <input type="radio" name="clubName" value="Élan Club" class="h-4 w-4 accent-gold" />
            <div>
              <span class="text-base font-medium text-charcoal">Élan Club</span>
              <p class="mt-0.5 text-xs font-light text-muted">French for passion and style. Sophisticated, memorable.</p>
            </div>
          </label>

          <label class="vote-option group flex cursor-pointer items-center gap-4 rounded-xl border border-divider bg-white/60 px-5 py-4 transition-all hover:border-gold/40 hover:bg-white">
            <input type="radio" name="clubName" value="Nexus Club" class="h-4 w-4 accent-gold" />
            <div>
              <span class="text-base font-medium text-charcoal">Nexus Club</span>
              <p class="mt-0.5 text-xs font-light text-muted">The point of connection. Modern, clean, powerful.</p>
            </div>
          </label>

          <label class="vote-option group flex cursor-pointer items-center gap-4 rounded-xl border border-divider bg-white/60 px-5 py-4 transition-all hover:border-gold/40 hover:bg-white">
            <input type="radio" name="clubName" value="The Commons" class="h-4 w-4 accent-gold" />
            <div>
              <span class="text-base font-medium text-charcoal">The Commons</span>
              <p class="mt-0.5 text-xs font-light text-muted">A shared space for remarkable people. Understated elegance.</p>
            </div>
          </label>

          <!-- Custom option -->
          <label class="vote-option group flex cursor-pointer items-center gap-4 rounded-xl border border-divider bg-white/60 px-5 py-4 transition-all hover:border-gold/40 hover:bg-white">
            <input type="radio" name="clubName" value="__custom__" id="custom-radio" class="h-4 w-4 accent-gold" />
            <div class="flex-1">
              <span class="text-base font-medium text-charcoal">Suggest your own</span>
              <input
                type="text"
                id="custom-name"
                placeholder="Your idea..."
                class="mt-2 hidden w-full border-b border-divider bg-transparent py-2 text-sm text-charcoal outline-none transition-colors focus:border-gold placeholder:text-muted/40"
              />
            </div>
          </label>
        </div>

        <!-- Voter Info -->
        <div class="mt-10 space-y-4">
          <div>
            <label for="voter-name" class="mb-2 block text-xs font-medium uppercase tracking-[0.12em] text-muted">Your name</label>
            <input type="text" id="voter-name" required
              class="w-full border-b-2 border-divider bg-transparent py-3 text-base text-charcoal outline-none transition-colors focus:border-gold placeholder:text-muted/30"
              placeholder="First name" />
          </div>
          <div>
            <label for="voter-email" class="mb-2 block text-xs font-medium uppercase tracking-[0.12em] text-muted">Email <span class="font-normal normal-case text-muted/50">(optional)</span></label>
            <input type="email" id="voter-email"
              class="w-full border-b-2 border-divider bg-transparent py-3 text-base text-charcoal outline-none transition-colors focus:border-gold placeholder:text-muted/30"
              placeholder="you@example.com" />
          </div>
        </div>

        <!-- Submit -->
        <button id="submit-vote" type="button" disabled
          class="mt-10 w-full rounded-full bg-charcoal px-10 py-4 text-sm font-medium text-cream opacity-40 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg disabled:pointer-events-none disabled:opacity-40">
          Cast Your Vote
        </button>
        <p id="vote-error" class="mt-3 hidden text-center text-xs text-red-500"></p>
      </div>

      <!-- Confirmation (hidden until voted) -->
      <div id="vote-results" class="mt-12 hidden">
        <p class="mb-6 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
          Vote Received
        </p>
        <h2 class="mb-8 font-serif text-2xl font-normal" style="letter-spacing: -0.02em;">
          Thanks for weighing in.
        </h2>
        <div class="rounded-xl border border-divider bg-white/60 px-5 py-5 text-left">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted/70">
            Your vote
          </p>
          <p id="selected-vote" class="mt-2 text-lg font-medium text-charcoal"></p>
          <p class="mt-3 text-sm font-light leading-relaxed text-muted">
            We keep individual ballots private and review aggregate feedback internally before announcing a final decision.
          </p>
        </div>

        <div class="mt-10 text-center">
          <a href="/" class="text-sm font-light text-gold transition-colors hover:text-charcoal">
            &larr; Back to homepage
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { db } from '../lib/firebase';
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';

  const form = document.getElementById('vote-form') as HTMLElement;
  const results = document.getElementById('vote-results') as HTMLElement;
  const submitBtn = document.getElementById('submit-vote') as HTMLButtonElement;
  const voterName = document.getElementById('voter-name') as HTMLInputElement;
  const voterEmail = document.getElementById('voter-email') as HTMLInputElement;
  const customName = document.getElementById('custom-name') as HTMLInputElement;
  const errorEl = document.getElementById('vote-error') as HTMLElement;
  const selectedVoteEl = document.getElementById('selected-vote') as HTMLElement;

  // Show custom input when "Suggest your own" is selected
  document.querySelectorAll('input[name="clubName"]').forEach((radio) => {
    radio.addEventListener('change', () => {
      const isCustom = (radio as HTMLInputElement).value === '__custom__';
      customName.classList.toggle('hidden', !isCustom);
      if (isCustom) {
        customName.focus();
      }
      validateForm();
    });
  });

  customName.addEventListener('input', validateForm);
  voterName.addEventListener('input', validateForm);

  function validateForm() {
    const selected = (document.querySelector('input[name="clubName"]:checked') as HTMLInputElement)?.value;
    const hasName = voterName.value.trim().length > 0;
    const hasSelection = selected && (selected !== '__custom__' || customName.value.trim().length > 0);

    submitBtn.disabled = !(hasName && hasSelection);
    submitBtn.classList.toggle('opacity-40', !(hasName && hasSelection));
  }

  submitBtn.addEventListener('click', async () => {
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
    errorEl.classList.add('hidden');

    try {
      let selectedName = (document.querySelector('input[name="clubName"]:checked') as HTMLInputElement)?.value;
      if (selectedName === '__custom__') {
        selectedName = customName.value.trim();
      }

      if (!selectedName || selectedName.length > 80) {
        throw new Error('Please choose a shorter name idea.');
      }

      const trimmedVoterName = voterName.value.trim();
      if (!trimmedVoterName || trimmedVoterName.length > 80) {
        throw new Error('Please enter your name.');
      }

      const normalizedEmail = voterEmail.value.trim().toLowerCase();
      if (normalizedEmail.length > 254) {
        throw new Error('Please use a shorter email address.');
      }

      await addDoc(collection(db, 'votes'), {
        clubName: selectedName,
        voterName: trimmedVoterName,
        voterEmail: normalizedEmail || null,
        createdAt: serverTimestamp(),
      });

      if (selectedVoteEl) {
        selectedVoteEl.textContent = selectedName;
      }

      form.classList.add('hidden');
      results.classList.remove('hidden');
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
      errorEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Cast Your Vote';
    }
  });
</script>
