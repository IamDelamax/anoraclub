---
---
<section id="path-chooser" class="bg-cream px-6 py-24 md:py-28">
  <div class="fade-in-up mx-auto max-w-[960px] text-center">
    <p class="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
      Two Levels
    </p>
    <h2
      class="mx-auto max-w-3xl font-serif font-normal leading-tight"
      style="font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.02em;"
    >
      Where are you on your <span class="italic text-gold">journey?</span>
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base font-light leading-relaxed text-muted" style="line-height: 1.75;">
      Whether you're looking for your person or growing together with someone — there's a place for you here.
    </p>

    <!-- Two cards -->
    <div class="mx-auto mt-14 grid max-w-[880px] gap-6 md:grid-cols-2">
      <!-- Level 1: Singles -->
      <button
        id="path-singles"
        type="button"
        class="path-card group relative overflow-hidden rounded-2xl border-2 border-divider bg-white p-8 text-left transition-all duration-300 hover:border-gold hover:shadow-lg"
      >
        <div class="relative z-10">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-gold">Level 1</p>
          <h3 class="font-serif text-2xl font-normal text-charcoal" style="letter-spacing: -0.02em;">
            For Singles
          </h3>
          <p class="mt-3 text-sm font-light leading-relaxed text-muted" style="line-height: 1.7;">
            Find your person through curated events and thoughtful introductions. No swiping, no algorithms — just real people in the right rooms.
          </p>
          <div class="mt-6 flex items-center gap-2 text-sm font-medium text-gold transition-colors group-hover:text-charcoal">
            <span>Explore</span>
            <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </button>

      <!-- Level 2: Couples -->
      <button
        id="path-couples"
        type="button"
        class="path-card group relative overflow-hidden rounded-2xl border-2 border-divider bg-white p-8 text-left transition-all duration-300 hover:border-gold hover:shadow-lg"
      >
        <div class="relative z-10">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-gold">Level 2</p>
          <h3 class="font-serif text-2xl font-normal text-charcoal" style="letter-spacing: -0.02em;">
            For Couples
          </h3>
          <p class="mt-3 text-sm font-light leading-relaxed text-muted" style="line-height: 1.7;">
            Grow together with other ambitious couples. Double dates, shared experiences, and a community that makes your relationship stronger.
          </p>
          <div class="mt-6 flex items-center gap-2 text-sm font-medium text-gold transition-colors group-hover:text-charcoal">
            <span>Explore</span>
            <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </button>
    </div>
  </div>
</section>

<!-- Singles Detail Section (hidden by default) -->
<section id="singles-detail" class="hidden bg-warm-white px-6 py-24 md:py-28">
  <div class="fade-in-up mx-auto max-w-[960px]">
    <div class="text-center">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
        Level 1 — Singles
      </p>
      <h2
        class="mx-auto max-w-3xl font-serif font-normal leading-tight"
        style="font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.02em;"
      >
        Find someone who makes your friends say <span class="italic text-gold">"how did you meet?"</span>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base font-light leading-relaxed text-muted" style="line-height: 1.75;">
        Stop leaving your love life to chance. Our curated events and thoughtful introductions put you in the same room as people who are genuinely worth your time.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-[880px] gap-8 md:grid-cols-3">
      <div class="rounded-xl border border-divider bg-white/60 p-6">
        <p class="mb-2 font-serif text-xl text-charcoal">Curated Events</p>
        <p class="text-sm font-light leading-relaxed text-muted">Intimate dinners for 12. Social evenings for 40. Designed so you actually talk to people.</p>
      </div>
      <div class="rounded-xl border border-divider bg-white/60 p-6">
        <p class="mb-2 font-serif text-xl text-charcoal">Thoughtful Matching</p>
        <p class="text-sm font-light leading-relaxed text-muted">We learn what matters to you and introduce you to people who share your values and energy.</p>
      </div>
      <div class="rounded-xl border border-divider bg-white/60 p-6">
        <p class="mb-2 font-serif text-xl text-charcoal">Graduate to Level 2</p>
        <p class="text-sm font-light leading-relaxed text-muted">Found your person here? Move up to our couples community and keep growing together.</p>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a
        href="/apply"
        class="inline-block rounded-full bg-charcoal px-10 py-4 text-sm font-medium text-cream transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
      >
        Apply as a Single
      </a>
          <p class="mt-3 text-xs font-light text-muted">Start with the application, then we take it from there.</p>
    </div>
  </div>
</section>

<!-- Couples Detail Section (hidden by default) -->
<section id="couples-detail" class="hidden bg-warm-white px-6 py-24 md:py-28">
  <div class="fade-in-up mx-auto max-w-[960px]">
    <div class="text-center">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
        Level 2 — Couples
      </p>
      <h2
        class="mx-auto max-w-3xl font-serif font-normal leading-tight"
        style="font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.02em;"
      >
        Finding each other was 10%. <span class="italic text-gold">Growing together is the other 90.</span>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base font-light leading-relaxed text-muted" style="line-height: 1.75;">
        Join a community of ambitious couples who invest in their relationship the same way they invest in their careers. Share experiences, learn from each other, and build something worth talking about.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-[880px] gap-8 md:grid-cols-3">
      <div class="rounded-xl border border-divider bg-white/60 p-6">
        <p class="mb-2 font-serif text-xl text-charcoal">Couples Events</p>
        <p class="text-sm font-light leading-relaxed text-muted">Double-date dinners, weekend experiences, and social gatherings exclusively for couples.</p>
      </div>
      <div class="rounded-xl border border-divider bg-white/60 p-6">
        <p class="mb-2 font-serif text-xl text-charcoal">Growth Together</p>
        <p class="text-sm font-light leading-relaxed text-muted">Access mentors, workshops, and conversations with couples who've built remarkable lives together.</p>
      </div>
      <div class="rounded-xl border border-divider bg-white/60 p-6">
        <p class="mb-2 font-serif text-xl text-charcoal">Power Couple Network</p>
        <p class="text-sm font-light leading-relaxed text-muted">Connect with couples who are building, creating, and supporting each other's ambitions.</p>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a
        href="/apply"
        class="inline-block rounded-full bg-charcoal px-10 py-4 text-sm font-medium text-cream transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
      >
        Apply as a Couple
      </a>
          <p class="mt-3 text-xs font-light text-muted">Couples membership opens through the same application flow.</p>
    </div>
  </div>
</section>

<script>
  const singlesBtn = document.getElementById('path-singles');
  const couplesBtn = document.getElementById('path-couples');
  const singlesDetail = document.getElementById('singles-detail');
  const couplesDetail = document.getElementById('couples-detail');

  function activatePath(path: 'singles' | 'couples') {
    const isS = path === 'singles';

    // Update button styles
    singlesBtn?.classList.toggle('border-gold', isS);
    singlesBtn?.classList.toggle('shadow-lg', isS);
    singlesBtn?.classList.toggle('bg-gold/5', isS);
    singlesBtn?.classList.toggle('border-divider', !isS);
    singlesBtn?.classList.toggle('bg-white', !isS);

    couplesBtn?.classList.toggle('border-gold', !isS);
    couplesBtn?.classList.toggle('shadow-lg', !isS);
    couplesBtn?.classList.toggle('bg-gold/5', !isS);
    couplesBtn?.classList.toggle('border-divider', isS);
    couplesBtn?.classList.toggle('bg-white', isS);

    // Show/hide detail sections
    singlesDetail?.classList.toggle('hidden', !isS);
    couplesDetail?.classList.toggle('hidden', isS);

    // Scroll to detail
    const target = isS ? singlesDetail : couplesDetail;
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Re-trigger fade animation
    const fadeEl = target?.querySelector('.fade-in-up');
    if (fadeEl) {
      fadeEl.classList.remove('visible');
      requestAnimationFrame(() => {
        fadeEl.classList.add('visible');
      });
    }
  }

  singlesBtn?.addEventListener('click', () => activatePath('singles'));
  couplesBtn?.addEventListener('click', () => activatePath('couples'));
</script>
