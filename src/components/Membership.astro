---
const cards = [
  {
    title: 'Curated events',
    description: 'Salons, dinners, cultural outings, and social nights — designed for real conversation, not networking theater.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  },
  {
    title: 'Thoughtful introductions',
    description: 'Personalized member matches based on real compatibility — not swipe fatigue. Quality over quantity, always.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  },
  {
    title: 'Private community',
    description: 'An active members-only group where real friendships and connections continue between events.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    title: 'Concierge support',
    description: 'Smart follow-through, reminders, and matchmaking assistance. We do the work so the connection feels effortless.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
  },
  {
    title: 'A vetted network',
    description: 'Ambitious, interesting, emotionally present people. Everyone here was interviewed and chosen for a reason.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
];
---
<section id="membership" class="bg-cream px-6 py-28 md:py-32">
  <div class="mx-auto max-w-[1100px]">
    <!-- Label -->
    <div class="fade-in-up text-center">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
        What You Get
      </p>
      <h2
        class="font-serif font-normal leading-tight"
        style="font-size: clamp(2.2rem, 4vw, 3.2rem); letter-spacing: -0.02em;"
      >
        Membership includes
      </h2>
    </div>

    <!-- Cards grid -->
    <div class="fade-in-up mx-auto mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card) => (
        <div class="group rounded-2xl border border-divider bg-warm-white p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
          <div class="mb-5 text-gold" set:html={card.icon} />
          <h3 class="mb-3 font-serif text-xl text-charcoal">{card.title}</h3>
          <p class="text-sm font-light leading-relaxed text-muted" style="line-height: 1.75;">
            {card.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Footnote -->
    <div class="fade-in-up mx-auto mt-12 max-w-[960px] rounded-2xl border border-divider bg-alt-bg p-6 text-center">
      <p class="font-serif text-sm italic text-muted" style="line-height: 1.75;">
        Founding members receive early access to new formats, smaller dinners, and priority consideration for curated introductions.
      </p>
    </div>
  </div>
</section>
