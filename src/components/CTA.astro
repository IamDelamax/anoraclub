---
---
<section class="relative overflow-hidden bg-charcoal px-6 py-28 text-cream md:py-32">
  <!-- Background image overlay -->
  <div class="absolute inset-0">
    <img
      src="/images/cta-people.jpg"
      alt=""
      class="h-full w-full object-cover opacity-15"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-charcoal/70"></div>
  </div>
  <div class="fade-in-up relative z-10 mx-auto max-w-[960px] text-center">
    <h2
      class="font-serif font-normal leading-tight"
      style="font-size: clamp(2.2rem, 4vw, 3.2rem); letter-spacing: -0.02em;"
    >
      Ready to meet differently?
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-base font-light leading-relaxed text-cream/70" style="line-height: 1.75;">
      Founding membership is limited. If this resonates, we'd like to hear from you.
    </p>

    <!-- Buttons -->
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="/apply"
        class="rounded-full bg-cream px-8 py-3.5 text-sm font-medium text-charcoal transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
      >
        Apply for Membership
      </a>
      <a
        href="/nominate"
        class="rounded-full border border-cream/30 px-8 py-3.5 text-sm font-medium text-cream transition-all duration-200 hover:-translate-y-0.5 hover:border-cream/60"
      >
        Nominate a Friend
      </a>
    </div>

    <!-- Fine print -->
    <p class="mt-6 text-xs font-light tracking-wide text-cream/50">
      Interview-based membership. Limited founding spots.
    </p>

    <!-- Counter echo -->
    <p class="mt-3 flex items-center justify-center gap-2 text-xs font-light text-cream/40">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green-500"></span>
      </span>
      <span id="cta-spots-remaining">28</span> spots remaining
    </p>
  </div>
</section>
