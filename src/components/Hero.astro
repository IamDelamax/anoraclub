---
---
<section id="hero" class="relative overflow-hidden bg-warm-white px-6 pt-28 pb-24 md:pt-36 md:pb-28">
  <div class="mx-auto max-w-[1040px]">
    <div class="fade-in-up text-center">
      <p class="mb-6 text-xs font-semibold uppercase tracking-[0.18em] text-gold">
        San Francisco &amp; Los Angeles
      </p>
      <h1
        class="mx-auto max-w-4xl font-serif font-normal leading-[1.04] text-charcoal"
        style="font-size: clamp(3.2rem, 7vw, 6rem); letter-spacing: -0.04em;"
      >
        Find your person.
        <span class="italic text-gold">Build together.</span>
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-lg font-light leading-relaxed text-soft-black md:text-xl" style="line-height: 1.8;">
        A private social club for ambitious people who want better rooms, stronger chemistry, and a more intentional path to relationships and community.
      </p>
      <p class="mt-5 font-serif text-lg italic text-muted md:text-xl">
        Singles start here. Couples grow here.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/#vote"
          class="hero-cta rounded-full bg-charcoal px-8 py-3.5 text-sm font-medium text-cream transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
          data-cta="hero-vote"
        >
          Vote On The Name
        </a>
        <a
          href="/apply"
          class="hero-cta rounded-full border border-charcoal px-8 py-3.5 text-sm font-medium text-charcoal transition-all duration-200 hover:-translate-y-0.5 hover:bg-charcoal hover:text-cream"
          data-cta="hero-apply"
        >
          Apply For Membership
        </a>
      </div>

      <p class="mt-6 text-xs font-light tracking-wide text-muted">
        Interview-based membership. Limited founding access.
      </p>
    </div>

    <div class="fade-in-up mt-16 grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-divider bg-white/65 px-6 py-5 text-left">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gold">Level 1</p>
        <p class="mt-3 font-serif text-2xl text-charcoal">Singles</p>
        <p class="mt-3 text-sm font-light leading-relaxed text-muted" style="line-height: 1.75;">
          Curated social rooms and thoughtful introductions for people looking for a real partnership.
        </p>
      </div>
      <div class="rounded-2xl border border-divider bg-white/65 px-6 py-5 text-left">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gold">Level 2</p>
        <p class="mt-3 font-serif text-2xl text-charcoal">Couples</p>
        <p class="mt-3 text-sm font-light leading-relaxed text-muted" style="line-height: 1.75;">
          Shared experiences, introductions to other couples, and a social life that supports what you’re building.
        </p>
      </div>
      <div class="rounded-2xl border border-divider bg-alt-bg px-6 py-5 text-left">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gold">Designed for</p>
        <p class="mt-3 font-serif text-2xl text-charcoal">High-agency people</p>
        <p class="mt-3 text-sm font-light leading-relaxed text-muted" style="line-height: 1.75;">
          Less noise, more context, and gatherings that feel like a social life instead of a funnel.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.hero-cta').forEach((el) => {
    el.addEventListener('click', () => {
      const ctaName = (el as HTMLElement).dataset.cta;
      if (typeof window !== 'undefined' && (window as any).gtag) {
        (window as any).gtag('event', 'cta_clicked', { cta: ctaName, section: 'hero' });
      }
    });
  });
</script>
