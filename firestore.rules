rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Applications: allow anyone to create, allow reads for status checking
    match /applications/{document=**} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Nominations: allow anyone to create, only admins can read/update/delete
    match /nominations/{document=**} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Counters: allow anyone to read, allow writes (for atomic increments)
    match /counters/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Newsletter subscribers: allow create and read (for dupe checking)
    match /newsletter_subscribers/{document=**} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
